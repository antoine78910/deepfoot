# Supabase (required for sign-in / Google OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias (same value as the publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Backend API (obligatoire en prod pour score/stats à jour sur /app/analyze)
# Local: http://localhost:8000  |  Prod: https://votre-api.railway.app ou https://api.deepfoot.io
NEXT_PUBLIC_API_URL=http://localhost:8000

# App subdomain in production (e.g. https://app.deepfoot.io)
NEXT_PUBLIC_APP_ORIGIN=https://app.deepfoot.io

# Supabase Dashboard → Authentication → URL Configuration (required or Google/email fall back to Site URL = localhost):
#   Site URL: https://app.deepfoot.io
#   Redirect URLs (add ALL of these, wildcards included):
#     https://app.deepfoot.io/auth/callback
#     https://app.deepfoot.io/**
#     https://deepfoot.io/**
#     https://www.deepfoot.io/**
#     http://localhost:3000/auth/callback
#     http://localhost:3000/**
#     http://app.localhost:3000/auth/callback
#     http://app.localhost:3000/**

# Canonical site URL for sitemap, canonical tags, OG (must match the domain where the site is served)
# Prod: https://deepfoot.io  — sitemap URLs must be on the same domain as the sitemap (Google rule)
NEXT_PUBLIC_SITE_URL=https://deepfoot.io
